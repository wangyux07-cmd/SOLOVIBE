# === 高德地图 Web 服务 API ===
# 地理信息、POI搜索、路径规划的统一入口
AMAP_API_KEY=5d3aea82d014899dab82d6a6dd444ed8
AMAP_BASE_URL=https://restapi.amap.com

# API服务终端点配置
AMAP_PLACE_SEARCH_URL=/v3/place/text
AMAP_PLACE_AROUND_URL=/v3/place/around
AMAP_DIRECTION_WALKING_URL=/v3/direction/walking
AMAP_DIRECTION_DRIVING_URL=/v3/direction/driving
AMAP_DIRECTION_TRANSIT_URL=/v3/direction/transit
AMAP_GEOCODE_URL=/v3/geocode/geo
AMAP_REVERSE_GEOCODE_URL=/v3/geocode/regeo

# === 安全和风控配置 ===
# Risk阈值配置（单位：人民币元/分钟）
COST_RISK_THRESHOLD_MEDIUM=80
COST_RISK_THRESHOLD_HIGH=200
DURATION_RISK_THRESHOLD_MEDIUM=120
DURATION_RISK_THRESHOLD_HIGH=360

# API请求超时设置（秒）
WEB_SEARCH_TIMEOUT=5
BOOKING_EXECUTION_TIMEOUT=30

# 流控配置（每秒请求数限制）
TAVILY_RATE_LIMIT=10
SERPER_RATE_LIMIT=10
MEITUAN_RATE_LIMIT=5
DIDI_RATE_LIMIT=5

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# === CORS配置 ===
# 允许的前端域名（生产环境请严格限制）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# === 缓存配置 ===
# 缓存TTL（秒）
CACHE_TTL_SECONDS=900
MEMORY_CACHE_MAX_SIZE=1000

# === 第三方服务降级配置 ===
# 在API不可用时的降级策略
ENABLE_FALLBACK_TO_STATIC_DATA=true
FALLBACK_DATA_RETENTION_HOURS=24

# === 监控和诊断配置 ===
# Prometheus监控（如启用）
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8001

# 健康检查端点
HEALTH_CHECK_PATH=/health

# === 开发环境特殊配置 ===
# 开发环境下可开启详细日志
DEV_MODE=false
MOCK_EXTERNAL_APIS=false

# === 生产环境安全配置 ===
# 生产环境CSRF保护
CSRF_ENABLED=true
SECRET_KEY=your-secret-key-here-change-in-production

# SSL/TLS配置（如需要）
SSL_CERT_PATH=
SSL_KEY_PATH=

# 允许的最大上传文件大小（字节）
MAX_UPLOAD_SIZE=10485760  # 10MB
