# SoloVibe 前端环境配置

# 基本配置
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# API端点
VITE_STREAM_CHAT_ENDPOINT=/api/v1/stream_chat
VITE_HEALTH_CHECK_ENDPOINT=/api/v1/health
VITE_CONFIG_STATUS_ENDPOINT=/api/v1/config-status

# WebSocket和SSE配置
VITE_SSE_RETRY_TIMEOUT=5000
VITE_MAX_RETRY_ATTEMPTS=3
VITE_BACKOFF_MULTIPLIER=1.5

# UI配置
VITE_APP_TITLE=SoloVibe - 独频漫游
VITE_APP_DESCRIPTION=AI驱动的个人体验发现与规划应用
VITE_MAX_CONVERSATION_HISTORY=50
VITE_TYPING_INDICATOR_DELAY=800

# 调试和开发配置
VITE_DEBUG=false
VITE_MOCK_API=false
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=info

# 性能配置
VITE_DEBOUNCE_DELAY=300
VITE_EVENT_CACHE_SIZE=100

# 安全配置
VITE_ENABLE_CORS=true
VITE_STRICT_CONTENT_SECURITY=true
VITE_RATE_LIMIT_REQUESTS=10
VITE_RATE_LIMIT_WINDOW=300000  # 5分钟（毫秒）

# 用户体验配置
VITE_CONFIRMATION_DIALOG_DURATION=2000
VITE_TOAST_DURATION=3000
VITE_ANIMATION_DURATION=300

# 主题配置（可选）
VITE_PRIMARY_COLOR="#4F46E5"
VITE_SECONDARY_COLOR="#06B6D4"
VITE_SUCCESS_COLOR="#10B981"
VITE_WARNING_COLOR="#F59E0B"
VITE_ERROR_COLOR="#EF4444"
VITE_BACKGROUND_COLOR="#FFFFFF"
VITE_TEXT_COLOR="#111827"

# 功能开关
VITE_ENABLE_HITL=true
VITE_ENABLE_BOOKING_CONFIRMATION=true
VITE_ENABLE_REAL_TIME_SEARCH=true
VITE_ENABLE_FALLBACK_UI=true

# 第三方服务（如需要）
# VITE_MAPBOX_TOKEN=your-mapbox-token
# VITE_ANALYTICS_ID=your-analytics-id

# 测试环境配置
VITE_TEST_API_BASE_URL=http://localhost:8000
VITE_MOCK_THREAD_ID=test-thread-123